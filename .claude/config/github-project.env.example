# GitHub Project source of truth
# Example org project URL:
# https://github.com/orgs/YOUR_ORG/projects/1
#
# Example user project URL:
# https://github.com/users/YOUR_USER/projects/1

GITHUB_PROJECT_OWNER="YOUR_ORG_OR_USER"
GITHUB_PROJECT_NUMBER="1"

# owner_type must be one of:
# org
# user
GITHUB_PROJECT_OWNER_TYPE="org"

# Optional default filters
GITHUB_PROJECT_DEFAULT_QUERY="is:issue is:open -status:Done"

# Optional repo for issue lookup / PR creation
GITHUB_REPOSITORY="YOUR_ORG_OR_USER/payment-gateway-service"